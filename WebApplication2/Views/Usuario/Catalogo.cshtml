@model IEnumerable<WebApplication2.Models.Libro>
@{
    ViewData["Title"] = "Catálogo de Libros";
}

<h2>📚 Catálogo de Libros</h2>
<div class="row g-3">
    @foreach (var libro in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@libro.Titulo</h5>
                    <p class="card-text text-muted">@libro.Autor</p>
                    <p class="card-text"><small>ISBN: @libro.ISBN</small></p>
                    <p class="card-text">Stock disponible: <strong>@libro.Stock</strong></p>
                </div>
                <div class="card-footer">
                    <form asp-action="Solicitar" asp-route-libroId="@libro.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100">Solicitar préstamo</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">← Volver</a>
</div>
