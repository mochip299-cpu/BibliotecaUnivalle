@model IEnumerable<WebApplication2.Models.Libro>
@{
    ViewData["Title"] = "Libros";
}

<h2>📚 Gestión de Libros</h2>
<a asp-action="CrearLibro" class="btn btn-primary mb-3">+ Nuevo Libro</a>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th><th>Título</th><th>Autor</th><th>ISBN</th><th>Stock</th><th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.Id</td>
                <td>@libro.Titulo</td>
                <td>@libro.Autor</td>
                <td>@libro.ISBN</td>
                <td>@libro.Stock</td>
                <td>
                    <a asp-action="EditarLibro" asp-route-id="@libro.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="EliminarLibro" asp-route-id="@libro.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('¿Eliminar este libro?')">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-secondary">← Volver</a>
