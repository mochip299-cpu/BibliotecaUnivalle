@model WebApplication2.Models.Libro
@{
    ViewData["Title"] = "Crear Libro";
}

<h2>📚 Nuevo Libro</h2>
<form asp-action="CrearLibro" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Autor" class="form-label"></label>
        <input asp-for="Autor" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ISBN" class="form-label"></label>
        <input asp-for="ISBN" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" class="form-control" type="number" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Libros" class="btn btn-secondary">Cancelar</a>
</form>
