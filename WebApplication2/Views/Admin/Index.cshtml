@{
    ViewData["Title"] = "Dashboard - Administrador";
}

<h2 class="mb-4">📊 Dashboard del Administrador</h2>
<p class="text-muted">Bienvenido, <strong>@User.Identity?.Name</strong></p>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body text-center">
                <h3>@ViewBag.TotalLibros</h3>
                <p class="mb-0">📚 Libros</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body text-center">
                <h3>@ViewBag.TotalUsuarios</h3>
                <p class="mb-0">👤 Usuarios</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body text-center">
                <h3>@ViewBag.TotalPrestamos</h3>
                <p class="mb-0">📋 Préstamos totales</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body text-center">
                <h3>@ViewBag.PrestamosActivos</h3>
                <p class="mb-0">🔴 Activos</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Libros"   class="btn btn-outline-primary me-2">📚 Gestionar Libros</a>
    <a asp-action="Usuarios" class="btn btn-outline-success me-2">👤 Gestionar Usuarios</a>
    <a asp-action="Prestamos" class="btn btn-outline-warning">📋 Ver Préstamos</a>
</div>
