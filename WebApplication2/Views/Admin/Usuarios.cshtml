@model IEnumerable<WebApplication2.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<h2>👤 Gestión de Usuarios</h2>
<a asp-action="CrearUsuario" class="btn btn-success mb-3">+ Nuevo Usuario</a>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th><th>Nombre</th><th>Email</th><th>Rol</th><th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Id</td>
                <td>@usuario.Nombre</td>
                <td>@usuario.Email</td>
                <td><span class="badge bg-secondary">@usuario.Rol</span></td>
                <td>
                    <a asp-action="EliminarUsuario" asp-route-id="@usuario.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('¿Eliminar este usuario?')">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-secondary">← Volver</a>
